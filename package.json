{
  "name": "flow-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node demos/weekly-report/server.mjs",
    "dev": "node demos/weekly-report/server.mjs",
    "demo:report": "node demos/weekly-report/server.mjs",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build-pages.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "preview": "node scripts/preview-site.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "test:http": "node scripts/flownote-http-smoke.mjs",
    "flownote:backup": "node demos/weekly-report/workspace-backup.mjs backup",
    "flownote:restore": "node demos/weekly-report/workspace-backup.mjs restore",
    "build:standalone": "node demos/weekly-report/build-standalone.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
